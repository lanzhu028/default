# 系统状态信息消息
builtin_interfaces/Time stamp          # 记录信息的时间
string hostname                        # 主机名
float32 cpu_percent                    # CPU 使用率 (%)
float32 memory_percent                 # 内存使用率 (%)
float32 memory_total                   # 内存总大小 (字节)
float32 memory_available               # 剩余可用内存 (字节)
float32 net_sent                       # 网络累计发送数据量 (字节)
float32 net_recv                       # 网络累计接收数据量 (字节)
